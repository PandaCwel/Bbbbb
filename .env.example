PORT=3001
NODE_ENV=development
# Ustaw tylko w środowisku produkcyjnym. Długa losowa wartość do podpisywania/ochrony sesji może być użyta przez hosting.
SESSION_SECRET=replace-with-a-long-random-secret
# Awaryjny identyfikator szkoły; aplikacja najpierw pobiera schoolId z profilu użytkownika.
SCHOOL_ID=
# Opcjonalnie: dozwolony origin frontendu, np. https://twoja-domena.example
APP_ORIGIN=
